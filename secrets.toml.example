# Same format as the ECDS app: one secrets block works for both apps.
# For local use, save a copy as .streamlit/secrets.toml (create the .streamlit folder next to app.py); on Streamlit Community Cloud paste into
# App settings -> Secrets. NEVER commit secrets.toml (it is in .gitignore).

EE_PROJECT = "your-google-cloud-project-id"

# Paste the ENTIRE service-account JSON key verbatim between the triple single quotes:
EE_SERVICE_ACCOUNT_JSON = '''
{"type": "service_account", "project_id": "...", "private_key_id": "...",
 "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
 "client_email": "...@....iam.gserviceaccount.com", "client_id": "...",
 "token_uri": "https://oauth2.googleapis.com/token"}
'''

# For local use with your own login (earthengine authenticate), you only need EE_PROJECT.
